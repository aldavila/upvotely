{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "src/lib/github-security.ts",
    "src/lib/integrations/github.ts",
    "src/app/api/integrations/github/**/*.ts",
    "src/app/(dashboard)/dashboard/settings/integrations/github/page.tsx",
    "tests/github.test.ts"
  ]
}
