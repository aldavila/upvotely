{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/lib/status-notification-policy.ts",
    "src/lib/unsubscribe-token.ts",
    "tests/**/*.ts",
    "src/lib/slack-security.ts"
  ]
}
