{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "src/lib/linear-*.ts",
    "src/lib/integrations/linear.ts",
    "src/app/api/integrations/linear/**/*.ts",
    "src/app/(dashboard)/dashboard/settings/integrations/linear/page.tsx",
    "tests/**/*.ts",
    "src/lib/slack-security.ts"
  ]
}
